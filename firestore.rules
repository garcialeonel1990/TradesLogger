rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Trades collection - estructura organizada por fecha:
    // trades/{fecha}/items/{tradeId}
    match /trades/{fecha}/items/{tradeId} {
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null &&
                          resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == resource.data.userId;
    }

    // Necesaria para las queries collectionGroup('items').
    // Una regla de ruta específica no habilita collection group queries:
    // hace falta el wildcard recursivo {path=**}.
    match /{path=**}/items/{tradeId} {
      allow read: if request.auth != null &&
                  resource.data.userId == request.auth.uid;
    }
    
    // Tickers collection - requiere autenticación
    match /tickers/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Bullrun collection - cargas de criptos organizadas por moneda
    // Estructura: bullrun/{cripto}/compras|ventas/{fecha_timestamp}
    match /bullrun/{cripto} {
      allow read, write: if request.auth != null;
    }

    match /bullrun/{cripto}/{subcoleccion}/{entryId} {
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.cripto == cripto;
      allow read, delete: if request.auth != null &&
                          resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.cripto == resource.data.cripto;
    }
    
    // Cauciones collection - lectura pública, escritura solo service account
    match /cauciones/{fecha}/lecturas/{document=**} {
      allow read: if true;
      allow write: if false; // Solo service account via admin SDK
    }
    
    // Max_dia collection - lectura pública, escritura solo service account
    match /max_dia/{document=**} {
      allow read: if true;
      allow write: if false; // Solo service account via admin SDK
    }

    // Telegram logs - diagnostico del scraper, escritura solo service account
    match /telegram_logs/{document=**} {
      allow read: if request.auth != null &&
                  request.auth.token.email == 'garcialeonel1990@gmail.com';
      allow write: if false; // Solo service account via admin SDK
    }
    
    // Config collection - solo admin puede escribir
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                   request.auth.token.email == 'garcialeonel1990@gmail.com';
    }
  }
}
